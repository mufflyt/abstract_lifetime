# Output (regenerable)
output/tables/
# Note: `output/figures/*` (glob, not a trailing slash) — git cannot re-include
# a file whose parent directory is itself excluded, so a trailing slash here
# would make every `!` exception below silently inert.
output/figures/*
# Exceptions: figures embedded in README.md
!output/figures/figure1_flow_diagram.png
!output/figures/figure2_km_curve.png
!output/figures/figure3_km_by_year.png
